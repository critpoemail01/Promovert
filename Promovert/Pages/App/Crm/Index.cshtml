@page
@model Promovert.Pages.App.Crm.IndexModel
@{
    ViewData["Title"] = "Import CSV leads";
}

<section class="app-page-hero">
    <div>
        <span class="tag mb-3">CSV import</span>
        <h1 class="hero-title fw-bold mb-2">Use your prospecting team leads in campaigns.</h1>
        <p class="lead muted mb-0">For now, import leads by selecting a CSV file. Then choose those contacts in the campaign builder.</p>
    </div>
    <div class="app-page-hero-actions">
        <a class="btn btn-primary btn-lg" asp-page="/App/Planner/Index" asp-fragment="campaign-config"><i class="bi bi-plus-lg me-1"></i>New campaign</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info mt-4 mb-0">@Model.StatusMessage</div>
}

<div class="dashboard-stat-grid mt-4">
    <div class="surface app-stat-card">
        <span class="app-stat-icon"><i class="bi bi-people"></i></span>
        <div>
            <div class="app-stat-label">CRM leads</div>
            <div class="app-stat-value">@Model.TotalLeads</div>
        </div>
    </div>
    <div class="surface app-stat-card">
        <span class="app-stat-icon"><i class="bi bi-envelope-check"></i></span>
        <div>
            <div class="app-stat-label">With email</div>
            <div class="app-stat-value">@Model.LeadsWithEmail</div>
        </div>
    </div>
    <div class="surface app-stat-card">
        <span class="app-stat-icon"><i class="bi bi-bullseye"></i></span>
        <div>
            <div class="app-stat-label">Ready for campaign</div>
            <div class="app-stat-value">@Model.ReadyForCampaign</div>
        </div>
    </div>
    <div class="surface app-stat-card">
        <span class="app-stat-icon"><i class="bi bi-shield-check"></i></span>
        <div>
            <div class="app-stat-label">With consent</div>
            <div class="app-stat-value">@Model.AuthorizedContacts</div>
        </div>
    </div>
    <div class="surface app-stat-card">
        <span class="app-stat-icon"><i class="bi bi-shield-x"></i></span>
        <div>
            <div class="app-stat-label">Excluded</div>
            <div class="app-stat-value">@Model.SuppressedContacts</div>
        </div>
    </div>
</div>

<section class="surface app-panel mt-4 crm-csv-import-panel">
    <div class="app-panel-header">
        <div>
            <h2>Import leads by CSV</h2>
            <p>Select a CSV from your CRM or prospecting list. Promovert reads the columns, suggests the match and asks for confirmation before import.</p>
        </div>
    </div>

    <form method="post" asp-page-handler="PreviewCsv" enctype="multipart/form-data" class="crm-form" data-csv-upload-form>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Import.CsvFile" class="form-label"></label>
                <input asp-for="Import.CsvFile" class="form-control" type="file" accept=".csv,text/csv" data-csv-file-input />
                <div class="form-text">The lead source automatically uses the file name. Consent and exclusions can be managed later.</div>
                <span asp-validation-for="Import.CsvFile" class="text-danger"></span>
            </div>
        </div>

        <button class="btn btn-outline-secondary mt-3" type="submit"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Read CSV columns</button>
    </form>

    @if (Model.CsvPreview is not null && Model.CsvPreview.Columns.Any())
    {
        <form method="post" asp-page-handler="ImportLeads" class="crm-form crm-column-map-form mt-4">
            <input asp-for="Import.Source" type="hidden" />
            <input asp-for="Import.RawCsv" type="hidden" />

            <div class="crm-csv-preview-summary">
                <div>
                    <strong>@Model.CsvPreview.Columns.Count columns detected</strong>
                    <span>Source: @Model.Import.Source</span>
                    <span>@Model.CsvPreview.SampleRows.Count preview row@(Model.CsvPreview.SampleRows.Count == 1 ? "" : "s") - delimiter '@Model.CsvPreview.Delimiter'</span>
                </div>
                <span>@(Model.CsvPreview.HasHeader ? "Header detected" : "No header detected")</span>
            </div>

            <div class="crm-column-map-grid mt-3">
                <label>
                    <span class="form-label">Email <small>required</small></span>
                    <select asp-for="Import.EmailColumn" class="form-select">
                        <option value="">Select CSV column</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                    <span asp-validation-for="Import.EmailColumn" class="text-danger"></span>
                </label>
                <label>
                    <span class="form-label">Contact name</span>
                    <select asp-for="Import.ContactNameColumn" class="form-select">
                        <option value="">Use email as name</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">Company</span>
                    <select asp-for="Import.CompanyNameColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">Role</span>
                    <select asp-for="Import.RoleColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">Industry</span>
                    <select asp-for="Import.IndustryColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">Country</span>
                    <select asp-for="Import.CountryColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">City</span>
                    <select asp-for="Import.CityColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">Status</span>
                    <select asp-for="Import.StageColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">Tags</span>
                    <select asp-for="Import.TagsColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">Phone</span>
                    <select asp-for="Import.PhoneColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">External ID</span>
                    <select asp-for="Import.ExternalIdColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="form-label">Notes</span>
                    <select asp-for="Import.NotesColumn" class="form-select">
                        <option value="">Do not import</option>
                        @foreach (var column in Model.CsvPreview.Columns)
                        {
                            <option value="@column.Index">@column.Label</option>
                        }
                    </select>
                </label>
            </div>

            <div class="crm-csv-preview-table mt-3">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            @foreach (var column in Model.CsvPreview.Columns)
                            {
                                <th>@column.Label</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.CsvPreview.SampleRows)
                    {
                        <tr>
                            @for (var i = 0; i < Model.CsvPreview.Columns.Count; i++)
                            {
                                <td>@(i < row.Count ? row[i] : "")</td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="alert-form-actions mt-4">
                <button class="btn btn-primary" type="submit"><i class="bi bi-cloud-arrow-up me-1"></i>Import mapped leads</button>
                <span class="muted">CSV import is the only import mode for now. Unsubscribed or excluded contacts are not used in email campaigns.</span>
            </div>
        </form>
    }
</section>

<section class="surface app-panel mt-4">
    <div class="app-panel-header">
        <div>
            <h2>Consent & Email Hub</h2>
            <p>Manage authorized contacts, unsubscribe and exclusion lists before using CRM emails in campaigns.</p>
        </div>
    </div>
    <div class="consent-hub-grid">
        <article>
            <span><i class="bi bi-envelope-check"></i></span>
            <strong>Allowed for outreach</strong>
            <p>Unknown or consented contacts can be selected for review. Consented contacts should have an explicit source.</p>
        </article>
        <article>
            <span><i class="bi bi-person-x"></i></span>
            <strong>Exclusion list</strong>
            <p>Unsubscribed or suppressed contacts are blocked from campaigns and visible for audit.</p>
        </article>
        <article>
            <span><i class="bi bi-window-stack"></i></span>
            <strong>Landing page capture</strong>
            <p>Public forms capture consent and return leads to CRM with campaign and channel source.</p>
        </article>
    </div>
</section>

<section class="surface app-panel mt-4">
    <div class="app-panel-header">
        <div>
            <h2>Imported CRM leads</h2>
            <p>These contacts become available as selectable audiences in the campaign builder.</p>
        </div>
    </div>

    @if (!Model.Leads.Any())
    {
        <div class="empty-state compact">
            <i class="bi bi-person-lines-fill"></i>
            <span>No imported CRM leads yet.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Contact</th>
                        <th>Company</th>
                        <th>Segment</th>
                        <th>Location</th>
                        <th>Stage</th>
                        <th>Consent</th>
                        <th>Source</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var lead in Model.Leads)
                {
                    <tr>
                        <td>
                            <strong>@lead.ContactName</strong>
                            <div class="text-muted">@lead.Email</div>
                        </td>
                        <td>
                            <strong>@lead.CompanyName</strong>
                            <div class="text-muted">@lead.Role</div>
                        </td>
                        <td>
                            <span>@lead.Industry</span>
                            <div class="text-muted">@lead.Tags</div>
                        </td>
                        <td>@string.Join(", ", new[] { lead.City, lead.Country }.Where(x => !string.IsNullOrWhiteSpace(x)))</td>
                        <td><span class="badge text-bg-secondary">@lead.Stage</span></td>
                        <td>
                            <form method="post" asp-page-handler="UpdateConsent" asp-route-leadId="@lead.Id" class="crm-consent-form">
                                <select class="form-select form-select-sm" name="consentStatus">
                                    @foreach (var status in Model.ConsentStatusOptions)
                                    {
                                        <option value="@status" selected="@(lead.ConsentStatus == status)">@status</option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Save</button>
                            </form>
                            <div class="text-muted small">@lead.ConsentSource</div>
                        </td>
                        <td>
                            <span>@lead.Source</span>
                            <div class="text-muted">@lead.Tags</div>
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="DeleteLead" asp-route-leadId="@lead.Id">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="surface app-panel mt-4">
    <div class="app-panel-header">
        <div>
            <h2>Captured leads by campaign</h2>
            <p>Landing page leads are stored with campaign, form consent and UTM/channel source.</p>
        </div>
    </div>

    @if (!Model.CapturedLandingLeads.Any())
    {
        <div class="empty-state compact">
            <i class="bi bi-person-plus"></i>
            <span>No leads captured by landing pages yet.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Lead</th>
                        <th>Campaign</th>
                        <th>Origin</th>
                        <th>Consent</th>
                        <th>Captured at</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var lead in Model.CapturedLandingLeads)
                {
                    <tr>
                        <td><strong>@lead.ContactName</strong><div class="text-muted">@lead.Email</div></td>
                        <td><strong>@lead.Campaign</strong><div class="text-muted">/@lead.LandingSlug</div></td>
                        <td><strong>@lead.Source</strong><div class="text-muted">@lead.CompanyName @lead.Role</div></td>
                        <td><span class="badge @(lead.ConsentAccepted ? "text-bg-success" : "text-bg-warning")">@(lead.ConsentAccepted ? "Accepted" : "Missing")</span></td>
                        <td class="text-muted">@lead.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-csv-file-input]').forEach((input) => {
            input.addEventListener('change', () => {
                if (input.files && input.files.length > 0) {
                    input.form?.requestSubmit();
                }
            });
        });
    </script>
}

