@page
@model Promovert.Pages.AboutModel
@{
    ViewData["Title"] = "About";
}

<section class="hero-section">
  <div class="container">
    <div class="page-hero">
      <div class="page-hero-grid">
        <div>
          <div class="hero-kicker mb-3">
            <i class="bi bi-megaphone-fill"></i>
            <span>About Promovert</span>
          </div>
          <h1 class="hero-title display-5 fw-bold mb-3">A practical way to turn companies into measurable campaigns.</h1>
          <p class="lead muted mb-4">
            Promovert helps founders, SMEs and sales teams turn a URL, company or business idea into complete campaigns with posts, emails, a landing page and reporting.
          </p>
          <div class="hero-actions">
            <button type="button" class="btn btn-primary btn-lg" data-auth-open="register">Start free</button>
            <a class="btn btn-outline-secondary btn-lg" asp-page="/HowItWorks">See workflow</a>
          </div>
          <div class="micro-proof-row">
            <span><i class="bi bi-check2"></i> Campaign as the main unit</span>
            <span><i class="bi bi-check2"></i> Built for acquisition</span>
            <span><i class="bi bi-check2"></i> Measurable funnel</span>
          </div>
        </div>

        <div class="quote-card">
          <p class="mb-3">
            "Describe what you sell once. Promovert turns it into campaigns that reach, engage and convert customers."
          </p>
          <div class="d-flex align-items-center gap-2 muted">
            <i class="bi bi-shield-check"></i>
            <span>Campaigns first. Vanity later.</span>
          </div>
        </div>
      </div>
    </div>

    <section class="mt-5">
      <div class="section-header">
        <span class="section-eyebrow"><i class="bi bi-compass"></i> Principles</span>
        <h2 class="section-title">Speed, clarity and measurable growth.</h2>
        <p class="section-copy">Every part of the product is designed to reduce the time between a commercial idea and a campaign that generates real data.</p>
      </div>

      <div class="value-grid">
        <div class="value-card">
          <div class="icon-pill"><i class="bi bi-bullseye"></i></div>
          <h2>Outcome over volume</h2>
          <p class="mb-0">The dashboard focuses on people reached, people who interacted and people who converted.</p>
        </div>
        <div class="value-card">
          <div class="icon-pill"><i class="bi bi-wallet2"></i></div>
          <h2>Fair capacity</h2>
          <p class="mb-0">Credits serve one-off launches. Unlimited serves teams with continuous campaigns.</p>
        </div>
        <div class="value-card">
          <div class="icon-pill"><i class="bi bi-globe2"></i></div>
          <h2>Multi-channel workflow</h2>
          <p class="mb-0">Social, email, landing page, CRM and tracking live in the same campaign workflow.</p>
        </div>
      </div>
    </section>

    <div class="conversion-band mt-4">
      <div>
        <span class="tag mb-2">Try it first</span>
        <h2 class="h3 fw-bold mb-2">Start with 5 free credits.</h2>
        <p class="mb-0 muted">Create a real campaign, review the dashboard and then choose credits or unlimited when you need more active platforms.</p>
      </div>
      <div class="conversion-actions">
        <button type="button" class="btn btn-primary btn-lg" data-auth-open="register">Create account</button>
        <a class="btn btn-outline-secondary btn-lg" asp-page="/Pricing">View pricing</a>
      </div>
    </div>
  </div>
</section>
