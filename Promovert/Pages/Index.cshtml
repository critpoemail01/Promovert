@page
@model Promovert.Pages.IndexModel
@{
    ViewData["Title"] = "Online campaign engine";
}

<section class="hero-section">
    <div class="container homepage-container">
        <div class="promo-strip mb-4">
            <div>
                <span class="promo-label"><i class="bi bi-lightning-charge-fill"></i> Launch</span>
                <span class="promo-copy">Start with 5 free credits. The unlimited plan is EUR 49.99/month or EUR 299/year when marketing becomes continuous.</span>
            </div>
            <a class="promo-link" asp-page="/Pricing">View pricing <i class="bi bi-arrow-right-short"></i></a>
        </div>

        <div class="surface hero-card p-4 p-md-5">
            <div class="row align-items-center g-4 hero-grid">
                <div class="col-lg-7">
                    <div class="hero-kicker mb-3">
                        <i class="bi bi-megaphone-fill"></i>
                        <span>Complete campaigns generated from one URL</span>
                    </div>

                    <h1 class="display-5 fw-bold hero-title mb-3">Promovert turns a company website into a complete campaign.</h1>
                    <p class="lead mb-4 muted">
                        Enter the URL, validate the Business DNA, choose a suggested campaign and approve the posts, emails and landing page before publishing.
                    </p>

                    <div class="hero-actions">
                        <button type="button" class="btn btn-primary btn-lg" data-auth-open="register">
                            Start free
                        </button>
                        <a class="btn btn-outline-secondary btn-lg" asp-page="/HowItWorks">How it works</a>
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-outline-secondary btn-lg" asp-page="/App/Dashboard">Open dashboard</a>
                        }
                    </div>

                    <div class="micro-proof-row">
                        <span><i class="bi bi-check2"></i> Business DNA from the URL</span>
                        <span><i class="bi bi-check2"></i> Posts, emails and landing page</span>
                        <span><i class="bi bi-check2"></i> Reach, interactions and conversions</span>
                    </div>

                    <div class="hero-proof mt-4">
                        <div>
                            <strong>3</strong>
                            <span>core metrics</span>
                        </div>
                        <div>
                            <strong>6</strong>
                            <span>marketing channels</span>
                        </div>
                        <div>
                            <strong>EUR 299</strong>
                            <span>unlimited/year</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="market-panel">
                        <div class="market-panel-header">
                            <span class="badge badge-soft">Complete campaign</span>
                            <span class="market-dot"></span>
                        </div>
                        <div class="market-card active">
                            <div>
                                <div class="fw-semibold">https://company.pt</div>
                                <div class="small muted">Business DNA + 14-day campaign</div>
                            </div>
                            <span class="signal signal-buy">Generating</span>
                        </div>
                        <div class="market-card">
                            <div>
                                <div class="fw-semibold">Posts by channel</div>
                                <div class="small muted">LinkedIn, Instagram, Facebook, TikTok</div>
                            </div>
                            <span class="signal">Draft</span>
                        </div>
                        <div class="market-card">
                            <div>
                                <div class="fw-semibold">Emails + landing page</div>
                                <div class="small muted">Follow-up, form and UTM</div>
                            </div>
                            <span class="signal">Approve</span>
                        </div>
                        <div class="market-panel-footer">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>Reached, interacted, converted. One dashboard.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <section class="campaign-unit-section mt-5">
            <div class="campaign-unit-head">
                <div class="section-header mb-0">
                    <span class="section-eyebrow"><i class="bi bi-stars"></i> Campaign as the main unit</span>
                    <h2 class="section-title">Strategy, content, lead capture and reporting in one workflow.</h2>
                    <p class="section-copy">Promovert turns a company website into a structured campaign: campaign brief, channel posts, email sequence, landing page, form, tracking and report.</p>
                </div>

                <div class="campaign-unit-outcomes" aria-label="Campaign outcomes">
                    <span class="tag">Business outcomes</span>
                    <div>
                        <strong>Reach</strong>
                        <small>Users reached by the campaign</small>
                    </div>
                    <div>
                        <strong>Interaction</strong>
                        <small>Clicks, replies, comments and form starts</small>
                    </div>
                    <div>
                        <strong>Conversion</strong>
                        <small>Leads, subscriptions or purchases</small>
                    </div>
                </div>
            </div>

            <div class="campaign-unit-grid">
                <div class="surface feature-card campaign-unit-card">
                    <div class="campaign-unit-card-top">
                        <span class="campaign-unit-step">01</span>
                        <div class="icon-pill"><i class="bi bi-fingerprint"></i></div>
                    </div>
                    <div>
                        <h5>Business DNA</h5>
                        <p class="mb-0 muted">Analyzes the URL and creates the commercial profile: product, audience, offer, tone, sector and campaign opportunities.</p>
                    </div>
                </div>

                <div class="surface feature-card campaign-unit-card">
                    <div class="campaign-unit-card-top">
                        <span class="campaign-unit-step">02</span>
                        <div class="icon-pill"><i class="bi bi-calendar2-week"></i></div>
                    </div>
                    <div>
                        <h5>Post calendar</h5>
                        <p class="mb-0 muted">Generates hooks, captions, short scripts and channel variations for the selected period.</p>
                    </div>
                </div>

                <div class="surface feature-card campaign-unit-card">
                    <div class="campaign-unit-card-top">
                        <span class="campaign-unit-step">03</span>
                        <div class="icon-pill"><i class="bi bi-window-stack"></i></div>
                    </div>
                    <div>
                        <h5>Landing page and leads</h5>
                        <p class="mb-0 muted">Creates a conversion page with form, UTM, tracking and campaign source.</p>
                    </div>
                </div>
            </div>

            <div class="campaign-unit-flow" aria-label="Campaign workflow">
                <span><i class="bi bi-link-45deg"></i> Company URL</span>
                <i class="bi bi-arrow-right"></i>
                <span><i class="bi bi-diagram-3"></i> Complete campaign</span>
                <i class="bi bi-arrow-right"></i>
                <span><i class="bi bi-check2-square"></i> Approval</span>
                <i class="bi bi-arrow-right"></i>
                <span><i class="bi bi-graph-up-arrow"></i> Report and next campaign</span>
            </div>
        </section>

        <div class="conversion-band mt-4">
            <div>
                <span class="tag mb-2">Best next step</span>
                <h2 class="fw-bold mb-2">Add a URL and generate your first campaign.</h2>
                <p class="mb-0 muted">Each credit covers one active campaign on one platform for 30 days. The unlimited plan covers every channel without counting credits.</p>
            </div>
            <div class="conversion-actions">
                <button type="button" class="btn btn-primary btn-lg" data-auth-open="register">Start free</button>
                <a class="btn btn-outline-secondary btn-lg" asp-page="/Pricing">View pricing</a>
            </div>
        </div>
    </div>
</section>
