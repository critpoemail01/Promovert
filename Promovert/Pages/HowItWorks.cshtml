@page
@model Promovert.Pages.HowItWorksModel
@{
    ViewData["Title"] = "How it works";
}

<section class="hero-section">
    <div class="container">
        <div class="page-hero">
            <div class="page-hero-grid">
                <div>
                    <div class="hero-kicker mb-3">
                        <i class="bi bi-diagram-3-fill"></i>
                        <span>From company to ready campaign</span>
                    </div>
                    <h1 class="hero-title display-5 fw-bold mb-3">Turn the company website into a complete campaign.</h1>
                    <p class="lead muted mb-4">
                        Promovert analyzes the URL, creates the Business DNA, suggests sector campaigns, and generates posts, emails, a landing page, form, tracking and report.
                    </p>
                    <div class="hero-actions">
                        <button type="button" class="btn btn-primary btn-lg" data-auth-open="register">Start free</button>
                        <a class="btn btn-outline-secondary btn-lg" asp-page="/Pricing">View pricing</a>
                    </div>
                    <div class="micro-proof-row">
                        <span><i class="bi bi-check2"></i> 5 free credits</span>
                        <span><i class="bi bi-check2"></i> Posts, emails and landing page</span>
                        <span><i class="bi bi-check2"></i> Leads, conversions and report</span>
                    </div>
                </div>

                <div class="proof-panel">
                    <div class="proof-row">
                        <i class="bi bi-link-45deg"></i>
                        <div>
                            <strong>Start with the URL</strong>
                            <span>Enter the website, company name or business idea.</span>
                        </div>
                    </div>
                    <div class="proof-row">
                        <i class="bi bi-stars"></i>
                        <div>
                            <strong>AI creates the plan</strong>
                            <span>Goal, audience, offer, channels, calendar and messages.</span>
                        </div>
                    </div>
                    <div class="proof-row">
                        <i class="bi bi-check2-square"></i>
                        <div>
                            <strong>You approve before publishing</strong>
                            <span>Nothing goes live without user or team approval.</span>
                        </div>
                    </div>
                    <div class="proof-row">
                        <i class="bi bi-graph-up-arrow"></i>
                        <div>
                            <strong>Measure the result</strong>
                            <span>Reach, interactions, leads, subscriptions and sales.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <section class="mt-5">
            <div class="section-header">
                <span class="section-eyebrow"><i class="bi bi-lightning-charge-fill"></i> Main workflow</span>
                <h2 class="section-title">The campaign is the main unit, not an isolated post.</h2>
                <p class="section-copy">Each campaign starts from a company, has a strategy, channel content, a conversion page and business measurement.</p>
            </div>

            <div class="step-grid workflow-step-grid">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h2>Company URL</h2>
                    <p class="mb-0">Promovert uses the website to understand the product, value proposition, audience and visual context.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h2>Business DNA</h2>
                    <p class="mb-0">Creates a commercial profile with problem, promise, segments, tone and likely channels.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h2>Suggested campaigns</h2>
                    <p class="mb-0">Suggests campaigns by sector, objective and maturity: leads, bookings, sales, launch or social proof.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">4</div>
                    <h2>Content by channel</h2>
                    <p class="mb-0">Generates posts for LinkedIn, Instagram, Facebook, TikTok and emails adapted to the selected period.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">5</div>
                    <h2>Landing page</h2>
                    <p class="mb-0">Creates a conversion page with CTA, form, UTM and tracking to capture leads.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">6</div>
                    <h2>Approval</h2>
                    <p class="mb-0">The user approves, rejects or edits posts before any publication is scheduled.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">7</div>
                    <h2>Authorized publishing</h2>
                    <p class="mb-0">Official publishing only happens on authorized accounts, pages or providers.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">8</div>
                    <h2>Report and next campaign</h2>
                    <p class="mb-0">The dashboard shows reach, interactions and conversions, then recommends the next step.</p>
                </div>
            </div>
        </section>

        <section class="conversion-band mt-4">
            <div>
                <span class="tag mb-2">Recommended MVP</span>
                <h2 class="h3 fw-bold mb-2">Start with a 14-day campaign.</h2>
                <p class="mb-0 muted">Company URL, Business DNA, 3 suggested campaigns, 5 LinkedIn posts, 5 Instagram posts, 3 emails, 1 landing page, UTM, lead capture and a simple dashboard.</p>
            </div>
            <div class="conversion-actions">
                <button type="button" class="btn btn-primary btn-lg" data-auth-open="register">Start free</button>
                <a class="btn btn-outline-secondary btn-lg" asp-page="/Pricing">View pricing</a>
            </div>
        </section>
    </div>
</section>
